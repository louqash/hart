# hart configuration — copy to .env and fill in. Full reference: docs/configuration.md
# Values marked (Settings) can also be changed later on the Settings page.

# --- Garmin Connect ---------------------------------------------------------
GARMIN_EMAIL=
# Needed for syncing from this machine without `hart auth` tokens; on a server it can stay empty.
GARMIN_PASSWORD=

# --- Claude (your subscription) -----------------------------------------------
# Create with `claude setup-token` (valid for 1 year).
CLAUDE_CODE_OAUTH_TOKEN=
# The date you ran `claude setup-token` — hart warns 30 days before it expires.
HART_CLAUDE_TOKEN_ISSUED_AT=

# --- Where and who ------------------------------------------------------------
# Your time zone: days, schedules and messages follow it.
HART_TZ=UTC
# Public host name, e.g. hart.<tailnet>.ts.net (links in messages, same-origin check).
HART_PUBLIC_HOST=
# Identity header set by your reverse proxy (Tailscale Serve sets Tailscale-User-Login).
HART_AUTH_HEADER=Tailscale-User-Login
# Comma-separated identities allowed in (empty = anyone your proxy lets through). Recommended.
# With Tailscale it's your login as the admin console shows it, e.g. you@example.com or you@github.
HART_ALLOWED_USERS=
# Local development only: skip the identity check (binds to 127.0.0.1).
# HART_ENV=dev

# --- Storage --------------------------------------------------------------------
# HART_DATA_DIR=data            # database, Garmin tokens and seed/ live here
# HART_BACKUP_DIR=/backups      # nightly DuckDB exports (create an empty .hart-backups file there)

# --- About you (Settings) -------------------------------------------------------
HART_ATHLETE_NAME=
# HART_POWER_SINGLE_SIDED=false
# HART_HAS_COACH=false

# --- Models (Settings) ------------------------------------------------------------
# HART_MODEL_CHAT=claude-opus-5-5
# HART_MODEL_SUGGEST=claude-opus-5-5
# HART_MODEL_GRADE=claude-sonnet-5
# HART_MODEL_PARSE=claude-haiku-4-5

# --- Discord (optional; docs/deployment.md#discord-optional) ---------------------
# A bot sends the evening message and lets you chat with Ember (tag @Ember, or DM it).
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# Discord user IDs Ember answers (default: the owner of the bot application).
# HART_DISCORD_ALLOWED_USERS=
# Or, for the evening message only: a channel webhook (Edit channel → Integrations → Webhooks).
# HART_DISCORD_WEBHOOK_URL=
# HART_DISCORD_USERNAME=Ember
# HART_DISCORD_AVATAR_URL=https://…/avatar.png   # must be public
# HART_EVENING_MESSAGE_AT=22:00                   # (Settings)

# --- CLI on another machine -------------------------------------------------------
# Send `hart sync`, `hart status` and `hart auth` token uploads to a running server.
# HART_SERVER_URL=https://hart.<tailnet>.ts.net
